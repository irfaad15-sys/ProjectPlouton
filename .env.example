# === Hermes v2 — Crypto Perp Scanner ===

# Coins (Hyperliquid perp symbols)
COINS=BTC,ETH,SOL,XRP,BNB,SUI,TAO,LINK,HYPE,ADA

# Paper trading
# UNITS: these are FRACTIONS, not percentages. 0.01 = 1%, 0.15 = 15%.
# risk_per_trade_pct is hard-capped at 0.1 (10%); the app refuses larger values.
PAPER_BALANCE=500
RISK_PER_TRADE_PCT=0.01
MAX_OPEN_TRADES=3
DAILY_LOSS_LIMIT_PCT=0.15

# Trading mode: "paper" only. "live" is NOT implemented and will refuse to start.
TRADING_MODE=paper

# Strategy: golden_pocket | smc | fib_golden_zone
STRATEGY_NAME=golden_pocket
MIN_CONFIDENCE_PCT=40
EXECUTION_TF_DEFAULT=4h
CONFIRMATION_TF=1h
TREND_TF=1d
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
MIN_SLOPE_PCT=0.002

# Paper trading cost model (applied to simulated fills for honest PnL)
# These are set in code defaults; override here only if needed.

# Chart
CHART_CANDLES_BEFORE_SIGNAL=400
CHART_CANDLES_AFTER_SIGNAL=100
CHART_WIDTH_PX=1600
CHART_HEIGHT_PX=800

# Discord
DISCORD_WEBHOOK_URL=

# Display
TIMEZONE=UTC
